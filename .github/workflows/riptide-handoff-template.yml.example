name: riptide-handoff-template

# Downstream-adopter template for the Riptide reviewer-ready evidence
# handoff.
#
# HOW TO USE THIS FILE:
#   1. Copy it into your own Solana program repo at
#      `.github/workflows/riptide-handoff.yml` (drop the `.example`
#      suffix).
#   2. Replace every `TODO(downstream):` placeholder with your own
#      values. Do NOT copy Riptide's shipping canonical hashes —
#      those belong to Riptide's own CI. Do NOT leave the CLI spec
#      or expected-hash placeholders untouched: the workflow is
#      designed to fail closed on unresolved TODOs rather than
#      silently pulling a moving target.
#   3. Also copy `scripts/ci/assert-canonical-hash.sh` and — if your
#      programs build against pinned native tooling — commit your own
#      tooling checksums alongside the workflow (Riptide uses
#      `scripts/ci/solana-release.sha256` as the reference pattern).
#   4. Commit the replay config / adapter / fixtures you want rerun,
#      then push once to confirm the workflow runs green on a clean
#      runner.
#   5. Forward the workflow run URL to reviewers as the "cold-start
#      reproducibility" handoff artifact.
#
# What this template guarantees when green:
#   - The named replay fixture reruns from committed files only.
#   - The pack's `manifest.json.canonical_hash` matches a value your
#     repo pins.
#   - Every third-party GitHub Action is used at a pinned commit SHA,
#     not a moving tag — a compromised tag cannot change what your
#     CI runs.
#   - The Solana toolchain is downloaded + checksum-verified before
#     any code from it executes.
#   - `npm ci --ignore-scripts` skips postinstall hooks so no
#     downstream npm dependency can RCE your runner during install.
#
# What this template does NOT do:
#   - Deploy programs. Mainnet deployment is outside the handoff shape.
#   - Ship with Riptide's hashes hard-coded. Every downstream repo
#     anchors its own hash — your proof, your byte-stability surface.
#
# See `docs/ci-handoff.md` in the Riptide repo for the full walkthrough.

on:
  push:
    branches: ["**"]
  pull_request:
    branches: ["**"]
  workflow_dispatch: {}

permissions:
  contents: read

env:
  # TODO(downstream): pin your Riptide CLI version here so reruns
  # stay byte-reproducible across CLI releases. Use a specific tag
  # like `@riptide/cli@0.6.0`. The placeholder value below is a
  # sentinel that makes the install step fail closed — the workflow
  # will NOT silently install `@riptide/cli@latest`, which would
  # execute the CLI's postinstall hook at a moving version. The
  # published npm package is scoped: `@riptide/cli` — NOT
  # `riptide-cli`.
  RIPTIDE_CLI_SPEC: "@riptide/cli@TODO_PIN_EXACT_VERSION"

  # TODO(downstream): pin the matching riptide-engine native release
  # tag (e.g. `v0.6.0`). Must resolve the same byte-identical engine
  # that `RIPTIDE_CLI_SPEC` was tested against — the CLI is a thin
  # driver, the engine carries all the determinism. The provisioning
  # step below downloads the engine from
  # https://github.com/riptidesim/riptide/releases/download/$RIPTIDE_ENGINE_VERSION/
  # and verifies against `scripts/ci/riptide-engine.sha256` before
  # wiring `RIPTIDE_ENGINE_BIN`.
  RIPTIDE_ENGINE_VERSION: "vTODO_PIN_EXACT_ENGINE_VERSION"

  # TODO(downstream): the expected canonical SHA256 of your replay's
  # SimulationResult. Regenerate with the engine test's
  # `RIPTIDE_DUMP_EXPECTED=1` path and pin the output here. Do NOT
  # copy Riptide's shipping hashes — those are not meaningful for
  # your program.
  EXPECTED_CANONICAL_HASH: "TODO_DOWNSTREAM_HASH_HERE_64_HEX_CHARS"

  # TODO(downstream): path to the replay-config JSON the workflow
  # runs. Committed alongside your adapter + trajectory fixtures.
  REPLAY_CONFIG: "fixtures/replays/your-replay-fixture/config.json"

  # TODO(downstream): run-id slug emitted by the engine. Run the
  # replay locally once and check the path the CLI prints in the
  # `wrote pack: .riptide/pack/<RUN_ID>` line.
  EXPECTED_RUN_ID: "TODO_DOWNSTREAM_RUN_ID"

jobs:
  riptide-handoff:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Fail closed on unresolved TODOs
        # Keeps copy-paste adopters from shipping a workflow that
        # silently installs a moving `@latest` or asserts against a
        # placeholder hash. Catches the common "I forgot to replace
        # the TODO" mistake before any third-party code runs.
        run: |
          set -euo pipefail
          missing=0
          case "$RIPTIDE_CLI_SPEC" in *TODO*) echo "RIPTIDE_CLI_SPEC still a TODO placeholder"; missing=1 ;; esac
          case "$RIPTIDE_ENGINE_VERSION" in *TODO*) echo "RIPTIDE_ENGINE_VERSION still a TODO placeholder"; missing=1 ;; esac
          case "$EXPECTED_CANONICAL_HASH" in *TODO*) echo "EXPECTED_CANONICAL_HASH still a TODO placeholder"; missing=1 ;; esac
          case "$REPLAY_CONFIG" in *your-replay-fixture*|*TODO*) echo "REPLAY_CONFIG still a TODO placeholder"; missing=1 ;; esac
          case "$EXPECTED_RUN_ID" in *TODO*) echo "EXPECTED_RUN_ID still a TODO placeholder"; missing=1 ;; esac
          if [ "$missing" -ne 0 ]; then
            echo "Edit .github/workflows/riptide-handoff.yml before the workflow can run." >&2
            exit 1
          fi

      - name: Checkout (fresh)
        # TODO(downstream): pin this to the commit SHA of whatever
        # actions/checkout release you adopt. Tag refs (@v4) are
        # mutable — anyone with push to actions/checkout can change
        # what this line executes. Use `gh api` or the GitHub UI to
        # resolve a tag to a SHA, then commit the SHA + a comment
        # recording the version.
        #
        # Example (v4.2.2):
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683

      - name: Install Rust toolchain (stable)
        # TODO(downstream): pin to the dtolnay/rust-toolchain commit
        # SHA for @stable at the time you adopt. The example SHA
        # below is current as of 2026-04-22; refresh it when you
        # want newer stable.
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8
        with:
          toolchain: stable

      # TODO(downstream): install the Solana CLI band your programs
      # build against. The pattern below follows the Riptide reference
      # flow: download the release tarball from anza-xyz/agave AND
      # verify it against a committed SHA256 checksum before extract.
      # Replace the version + checksum with the values your programs
      # pin. Do NOT fall back to `curl ... | sh` — a swapped installer
      # would run before any verification.
      - name: Install Solana CLI (pinned + checksum-verified)
        env:
          # TODO(downstream): version tag from anza-xyz/agave releases.
          SOLANA_VERSION: v3.0.13
        run: |
          set -euo pipefail
          tarball="solana-release-x86_64-unknown-linux-gnu.tar.bz2"
          url="https://github.com/anza-xyz/agave/releases/download/${SOLANA_VERSION}/${tarball}"
          workdir="$(mktemp -d)"
          curl -fsSL --retry 3 --retry-all-errors -o "${workdir}/${tarball}" "${url}"
          # TODO(downstream): commit a `scripts/ci/solana-release.sha256`
          # file in your repo with the expected SHA256 for the tarball
          # above. See Riptide's reference copy for the format.
          (
            cd "${workdir}" && \
            sha256sum -c "${GITHUB_WORKSPACE}/scripts/ci/solana-release.sha256"
          )
          mkdir -p "${HOME}/.local/share/solana/install/active_release"
          tar -xjf "${workdir}/${tarball}" \
            -C "${HOME}/.local/share/solana/install/active_release" \
            --strip-components=1
          echo "${HOME}/.local/share/solana/install/active_release/bin" >> "$GITHUB_PATH"

      # TODO(downstream): build every program your replay-config
      # references. Keep each build step explicit so a reviewer can
      # see which .so files ship and where they land.
      - name: Build your Solana programs
        run: |
          set -euo pipefail
          cargo build-sbf --manifest-path programs/your-program/Cargo.toml

      - name: Set up Node.js
        # TODO(downstream): pin to the actions/setup-node SHA of
        # whatever release you adopt. Example below is v4.1.0.
        uses: actions/setup-node@39370e3970a6d050c480ffad4ff0ed4d3fdee5af
        with:
          node-version: "24"

      - name: Install the Riptide CLI
        # `--ignore-scripts` prevents the package's postinstall hook
        # from running on every CI invocation. Riptide's CLI uses
        # that hook to download the native engine binary from GitHub
        # Releases at install time; in CI you want the install step
        # to be pure npm metadata resolution. The explicit engine
        # provisioning step below replaces the postinstall with a
        # checksum-verified download your reviewers can audit.
        #
        # The published `@riptide/cli` tarball ships an
        # `npm-shrinkwrap.json` alongside `package.json`, so the
        # `npm install` below uses THAT as the authoritative
        # dependency tree — not npm's live caret-range resolution.
        # Every transitive dep version is byte-stable across time
        # for a given `RIPTIDE_CLI_SPEC`. If the shrinkwrap is
        # missing from the installed package (e.g. an older CLI
        # release), the install step exits 1 below.
        run: |
          set -euo pipefail
          npm install --global --ignore-scripts "$RIPTIDE_CLI_SPEC"
          riptide --version
          # Confirm the installed CLI ships a shrinkwrap — required
          # for byte-stable transitive-dep resolution.
          cli_root="$(npm root --global)/@riptide/cli"
          if [ ! -f "${cli_root}/npm-shrinkwrap.json" ]; then
            echo "riptide-handoff: installed CLI at ${cli_root} is missing npm-shrinkwrap.json." >&2
            echo "  This means transitive npm deps were resolved from live ranges, not a locked tree." >&2
            echo "  Upgrade RIPTIDE_CLI_SPEC to a release that ships the shrinkwrap." >&2
            exit 1
          fi

      - name: Provision riptide-engine (pinned + checksum-verified)
        # Because the CLI was installed with `--ignore-scripts`, the
        # `<pkg-root>/bin/riptide-engine` path the orchestrator would
        # normally find is empty. This step downloads the native
        # engine artifact from the pinned Riptide release, verifies
        # its SHA256 against a committed checksum file, and wires
        # `RIPTIDE_ENGINE_BIN` so every subsequent `riptide replay` /
        # `riptide run` invocation in this job picks it up.
        #
        # The URL layout matches the CLI's built-in postinstall
        # resolver: https://github.com/riptidesim/riptide/releases/
        #   download/<tag>/riptide-engine-<target-triple>
        # Default target is linux x86_64 — edit the TARGET_TRIPLE if
        # you're running on a different runner.
        env:
          TARGET_TRIPLE: "x86_64-unknown-linux-gnu"
        run: |
          set -euo pipefail
          asset="riptide-engine-${TARGET_TRIPLE}"
          url="https://github.com/riptidesim/riptide/releases/download/${RIPTIDE_ENGINE_VERSION}/${asset}"
          workdir="$(mktemp -d)"
          curl -fsSL --retry 3 --retry-all-errors -o "${workdir}/${asset}" "${url}"
          # TODO(downstream): commit `scripts/ci/riptide-engine.sha256`
          # in your repo with the expected SHA256 for the engine
          # artifact above. See Riptide's
          # `scripts/ci/riptide-engine.sha256.example` for format +
          # regeneration command. Bumping `RIPTIDE_ENGINE_VERSION`
          # MUST land together with the refreshed checksum.
          (
            cd "${workdir}" && \
            sha256sum -c "${GITHUB_WORKSPACE}/scripts/ci/riptide-engine.sha256"
          )
          chmod +x "${workdir}/${asset}"
          echo "RIPTIDE_ENGINE_BIN=${workdir}/${asset}" >> "$GITHUB_ENV"

      - name: Run the committed replay fixture
        run: |
          set -euo pipefail
          riptide replay "$REPLAY_CONFIG" --allow-invariant-violations

      # The assertion script is POSIX sh, so it runs unchanged under
      # Linux /dash, macOS stock /sh, and Alpine /ash. Copy
      # `scripts/ci/assert-canonical-hash.sh` verbatim from the
      # Riptide repo into your own repo, or invoke your vendored copy.
      - name: Assert pack canonical_hash matches the pinned value
        run: |
          set -euo pipefail
          manifest=".riptide/pack/$EXPECTED_RUN_ID/manifest.json"
          ./scripts/ci/assert-canonical-hash.sh "$manifest" "$EXPECTED_CANONICAL_HASH"

      - name: Upload emitted pack as workflow artifact
        if: always()
        # TODO(downstream): pin actions/upload-artifact to a SHA.
        # Example below is v4.4.3.
        uses: actions/upload-artifact@b4b15b8c7c6ac21ea08fcf65892d2ee8f75cf882
        with:
          name: riptide-pack
          path: .riptide/pack/
          if-no-files-found: warn
