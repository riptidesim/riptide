/target/
/dist/
/programs/*/target/
/cli/node_modules/
/cli/dist/
/cli/test-ledger/
/test-ledger/
/.agents/

# pyth-sdk-solana helper crate lives outside the main
# workspace so its legacy borsh 0.10 / solana-program 1.18 dep tree
# doesn't leak into the engine. Build artifacts stay local; the
# Cargo.lock is regenerated per dev/CI machine.
/programs/pyth_consumer_test_helper/target/
/programs/pyth_consumer_test_helper/Cargo.lock

# `riptide run` state + run artifacts — generated per invocation, not
# source. User-authored `.riptide/adapters/`, `.riptide/personas/`,
# and `.riptide/scenarios/` remain tracked in user repos; only the
# transient state + run outputs are ignored.
.riptide/last-run.json
.riptide/run-collection.json
.riptide/runs/
.riptide/campaigns/
.riptide/pack/
fixtures/replays/*/.riptide/pack/

# Replay engine build artifacts — re-generated on every `riptide replay` run
fixtures/replays/*/riptide-output/

# Local readiness/report exports; keep out of the GitHub repository.
reports/case-study-readiness/
