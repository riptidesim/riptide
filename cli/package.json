{
  "name": "@riptide/cli",
  "version": "0.9.1",
  "description": "Riptide CLI — deterministic multi-agent simulator for Solana programs. Runs hundreds of adversarial personas against your code in LiteSVM and maps the knife edge before mainnet does.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/riptidesim/riptide.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/riptidesim/riptide",
  "bugs": {
    "url": "https://github.com/riptidesim/riptide/issues"
  },
  "keywords": [
    "solana",
    "simulation",
    "litesvm",
    "agent-based",
    "defi",
    "riptide"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "riptide": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/src/**/*.d.ts",
    "dist/sim-runtime",
    "dist/skills",
    "assets",
    "scripts/install-binary.js",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json && node ./scripts/build-studio-app.mjs && node ./scripts/copy-personas.mjs",
    "build:studio-app": "node ./scripts/build-studio-app.mjs",
    "test": "npm run build && node ./scripts/run-tests.mjs",
    "postinstall": "node scripts/install-binary.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^8.2.0",
    "toml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
