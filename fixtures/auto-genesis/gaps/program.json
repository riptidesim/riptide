      "name": "vault",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "pubkey" },
          { "name": "deposited", "type": "u64" }
        ]
      }
    },
    {
      "name": "deposit_receipt",
      "type": {
