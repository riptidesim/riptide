      "name": "deposit",
      "discriminator": [242, 35, 198, 137, 82, 225, 242, 182],
      "accounts": [
        { "name": "depositor", "signer": true, "writable": false },
        { "name": "vault", "signer": false, "writable": true, "pda": { "seeds": [] } },
        { "name": "deposit_receipt", "signer": false, "writable": true },
        { "name": "collateral_ata", "signer": false, "writable": true },
        { "name": "price_feed", "signer": false, "writable": false },
        { "name": "fee_sink", "signer": false, "writable": true },
        { "name": "token_program", "signer": false, "writable": false }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    }
  ],
  "accounts": [
