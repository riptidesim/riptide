{
  "version": "0.1.0",
  "name": "perps_fork",
  "description": "Minimal perps-lite fork (Sprint 5 T07). Long/short positions against the admin-mock oracle. Funding rate and insurance fund are deliberately out of scope — see the T07 task note for the scope-cut rationale. The runtime (generic-primitive) dispatches only the u64-arg instructions (deposit_collateral, withdraw_collateral); open/close/liquidate are present for classification shape but require on-chain sequencing the generic harness does not express in Sprint 5.",
  "instructions": [
    {
      "name": "initialize_market",
      "discriminator": [0],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": [
        { "name": "max_leverage_bps", "type": "u64" },
        { "name": "liquidation_threshold_bps", "type": "u64" }
      ]
    },
    {
      "name": "deposit_collateral",
      "discriminator": [1],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "withdraw_collateral",
      "discriminator": [2],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "open_position",
      "discriminator": [3],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": [
        { "name": "side", "type": "u64" },
        { "name": "leverage_bps", "type": "u64" },
        { "name": "notional", "type": "u64" }
      ]
    },
    {
      "name": "close_position",
      "discriminator": [4],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": []
    },
    {
      "name": "liquidate_position",
      "discriminator": [5],
      "accounts": [
        { "name": "liquidator", "signer": true, "writable": false },
        { "name": "market", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "market",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "admin", "type": "pubkey" },
        { "name": "oracle", "type": "pubkey" },
        { "name": "max_leverage_bps", "type": "u64" },
        { "name": "liquidation_threshold_bps", "type": "u64" },
        { "name": "total_oi_long", "type": "u64" },
        { "name": "total_oi_short", "type": "u64" },
        { "name": "total_collateral", "type": "u64" },
        { "name": "cumulative_socialized_loss", "type": "u64" }
      ]
    },
    {
      "name": "position",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "owner", "type": "pubkey" },
        { "name": "market", "type": "pubkey" },
        { "name": "side", "type": "u64" },
        { "name": "collateral", "type": "u64" },
        { "name": "notional", "type": "u64" },
        { "name": "entry_price", "type": "u64" },
        { "name": "leverage_bps", "type": "u64" },
        { "name": "liquidated", "type": "bool" }
      ]
    }
  ]
}
