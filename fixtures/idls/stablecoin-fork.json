{
  "version": "0.1.0",
  "name": "stablecoin_fork",
  "description": "Minimal stablecoin fork. Collateral backing, stable supply, redemption queue, reserve buffer, and one authority-gated hedge-loss / NAV-haircut mutation that shrinks collateral backing under stress. Runtime-dispatchable actions: deposit_collateral (single u64), mint_stable (single u64), request_redeem (single u64), claim_redeem (zero-arg). apply_hedge_loss is an admin scheduled action; initialize_pool is declared for classification shape but not runtime-dispatched (the generic harness lazy-inits the pool on first touch).",
  "instructions": [
    {
      "name": "initialize_pool",
      "discriminator": [0],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": []
    },
    {
      "name": "deposit_collateral",
      "discriminator": [1],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "mint_stable",
      "discriminator": [2],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "request_redeem",
      "discriminator": [3],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "stable_amount", "type": "u64" }
      ]
    },
    {
      "name": "claim_redeem",
      "discriminator": [4],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "position", "signer": false, "writable": true }
      ],
      "args": []
    },
    {
      "name": "apply_hedge_loss",
      "discriminator": [5],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "loss_bps", "type": "u64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "pool",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "admin", "type": "pubkey" },
        { "name": "oracle", "type": "pubkey" },
        { "name": "collateral_assets", "type": "u64" },
        { "name": "stable_supply", "type": "u64" },
        { "name": "reserve_buffer_assets", "type": "u64" },
        { "name": "pending_redemption_assets", "type": "u64" },
        { "name": "pending_redemption_count", "type": "u64" },
        { "name": "effective_collateral_ratio_bps", "type": "u64" },
        { "name": "cumulative_hedge_loss_bps", "type": "u64" }
      ]
    },
    {
      "name": "position",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "owner", "type": "pubkey" },
        { "name": "pool", "type": "pubkey" },
        { "name": "collateral_deposited", "type": "u64" },
        { "name": "stable_minted", "type": "u64" },
        { "name": "pending_redeem_assets", "type": "u64" },
        { "name": "claimable_collateral", "type": "u64" },
        { "name": "cumulative_claimed", "type": "u64" }
      ]
    }
  ]
}
