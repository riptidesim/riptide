{
  "version": "0.1.0",
  "name": "liquid_staking",
  "description": "Minimal liquid-staking fork. Pooled stake, LST supply, withdrawal queue, reserve buffer, and one authority-gated slash that drops the exchange rate under stress. Runtime-dispatchable actions: stake (single u64), request_unstake (single u64), claim_unstake (zero-arg). apply_slash is an admin scheduled action; initialize_pool is declared for classification shape but not runtime-dispatched (the generic harness lazy-inits the pool on first touch).",
  "instructions": [
    {
      "name": "initialize_pool",
      "discriminator": [0],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "oracle", "signer": false, "writable": false }
      ],
      "args": [
        { "name": "initial_exchange_rate_bps", "type": "u64" }
      ]
    },
    {
      "name": "stake",
      "discriminator": [1],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "stake_account", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "request_unstake",
      "discriminator": [2],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "stake_account", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "lst_amount", "type": "u64" }
      ]
    },
    {
      "name": "claim_unstake",
      "discriminator": [3],
      "accounts": [
        { "name": "owner", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true },
        { "name": "stake_account", "signer": false, "writable": true }
      ],
      "args": []
    },
    {
      "name": "apply_slash",
      "discriminator": [4],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "slash_bps", "type": "u64" }
      ]
    },
    {
      "name": "admin_mint_lst",
      "discriminator": [5],
      "accounts": [
        { "name": "admin", "signer": true, "writable": false },
        { "name": "pool", "signer": false, "writable": true }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "pool",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "admin", "type": "pubkey" },
        { "name": "oracle", "type": "pubkey" },
        { "name": "total_assets", "type": "u64" },
        { "name": "lst_supply", "type": "u64" },
        { "name": "reserve_buffer", "type": "u64" },
        { "name": "pending_unstake_assets", "type": "u64" },
        { "name": "pending_unstake_count", "type": "u64" },
        { "name": "exchange_rate_bps", "type": "u64" },
        { "name": "cumulative_slashed", "type": "u64" }
      ]
    },
    {
      "name": "stake_account",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
        { "name": "owner", "type": "pubkey" },
        { "name": "pool", "type": "pubkey" },
        { "name": "lst_balance", "type": "u64" },
        { "name": "pending_unstake_assets", "type": "u64" },
        { "name": "claimable_assets", "type": "u64" },
        { "name": "cumulative_claimed", "type": "u64" }
      ]
    }
  ]
}
