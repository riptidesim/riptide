{
  "version": "0.1.0",
  "name": "admin_mock_oracle",
  "description": "Minimal admin-settable oracle program. First concrete target for OracleKind::AdminMock (generic oracle injection).",
  "instructions": [
    {
      "name": "initializeOracle",
      "discriminator": [0],
      "accounts": [
        { "name": "oracle", "writable": true, "signer": false },
        { "name": "admin", "writable": false, "signer": true }
      ],
      "args": [
        { "name": "price", "type": "u64" },
        { "name": "exponent", "type": "i8" }
      ]
    },
    {
      "name": "setPrice",
      "discriminator": [1],
      "accounts": [
        { "name": "oracle", "writable": true, "signer": false },
        { "name": "admin", "writable": false, "signer": true }
      ],
      "args": [
        { "name": "price", "type": "u64" },
        { "name": "exponent", "type": "i8" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "oracleState",
      "fields": [
        { "name": "is_initialized", "type": "bool" },
