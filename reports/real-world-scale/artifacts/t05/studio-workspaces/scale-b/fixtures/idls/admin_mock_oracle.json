        { "name": "price", "type": "u64" },
        { "name": "exponent", "type": "i8" },
        { "name": "reserved_0", "type": "u8" },
        { "name": "reserved_1", "type": "u8" },
        { "name": "reserved_2", "type": "u8" },
        { "name": "reserved_3", "type": "u8" },
        { "name": "reserved_4", "type": "u8" },
        { "name": "reserved_5", "type": "u8" },
        { "name": "reserved_6", "type": "u8" },
        { "name": "reserved_7", "type": "u8" }
      ]
    }
  ]
}
